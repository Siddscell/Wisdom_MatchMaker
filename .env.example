# Copy to backend/.env (backend settings) and frontend/.env (only the VITE_* lines).
# Never commit real values.

# --- Backend ---
ENV=development                       # development | production (production hides /api/dev/*)
# Supabase: Project Settings -> Database -> Connection string -> "Direct connection" or
# "Session pooler". postgresql:// URLs are accepted as-is.
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/postgres
CORS_ORIGINS=http://localhost:5173    # comma-separated
# Supabase Auth (Project Settings -> API): the backend asks Supabase who a login token is.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                     # must match vector(384) in the migrations
CLIP_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
CLIP_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
VISUAL_IMAGE_FLOOR=0.64               # photo <-> photo calibration (measured, docs/AI_MATCHING.md)
VISUAL_IMAGE_RANGE=0.16
VISUAL_TEXT_FLOOR=0.23                # photo <-> text calibration
VISUAL_TEXT_RANGE=0.09
TEXT_CONFIDENT=0.5                    # text semantic below which photos decide the meaning sub-score

STRICT_CATEGORY=true
MIN_QTY_FRACTION=0.25
MAX_LEAD_FACTOR=2.0
MAX_BUDGET_FACTOR=1.5
RETRIEVE_K=30
MAX_MATCHES_PER_ITEM=10
MATCH_MIN_SCORE=60
MIN_SEMANTIC=0.1                      # semantic sub-score below which a pair is never stored
NOTIFY_MIN_SCORE=70
SEMANTIC_FLOOR=0.65                   # cosine at which the semantic sub-score starts above 0
SEMANTIC_RANGE=0.28                   # cosine span from 0 to 1 (0.65 -> 0, 0.93 -> 1)
RANKER_PRIOR_STRENGTH=50              # accept/reject decisions at which learned weights count as much as the WEIGHT_* prior

WEIGHT_SEMANTIC=0.40                  # starting weights (the learned ranker's prior); must sum to 1
WEIGHT_PRICE=0.20
WEIGHT_QUANTITY=0.15
WEIGHT_DELIVERY=0.15
WEIGHT_LOCATION=0.10

EMAIL_BACKEND=outbox                  # outbox | smtp
# Gmail: smtp.gmail.com, port 587, your address as user and from, a Google App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GEOCODER=nominatim                    # nominatim | none

# Tests only: an EMPTY throwaway database whose name contains "test" (it is wiped).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchmaking_test

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
# Required for accounts (also enables Realtime notifications). Same values as
# SUPABASE_URL / SUPABASE_ANON_KEY above. Never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
